<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Flota.Presentation</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <!-- CA2007: kontynuacje modeli widoku muszą wracać do wątku interfejsu -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flota.Core\Flota.Core.csproj" />
    <ProjectReference Include="..\Flota.Client\Flota.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flota.Presentation.Tests" />
  </ItemGroup>

</Project>
