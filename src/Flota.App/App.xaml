<Application x:Class="Flota.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedTheme="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme xmlns:utum="using:Uno.Toolkit.UI.Material"
                                   ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/ColorPaletteOverride.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/FlotaStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
