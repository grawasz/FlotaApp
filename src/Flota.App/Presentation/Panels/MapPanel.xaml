<UserControl x:Class="Flota.App.Presentation.Panels.MapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Flota.App.Controls"
             xmlns:mapsui="using:Mapsui.UI.WinUI">

  <controls:PanelFrame x:Uid="PanelMap" Title="Mapa" Icon="map_16x16.png" Padding="0">
    <Grid x:Name="MapHost" MinHeight="240">
      <Grid.ContextFlyout>
        <MenuFlyout>
          <MenuFlyoutSubItem x:Uid="MapDefaultView" Text="Widok początkowy">
            <MenuFlyoutItem x:Uid="MapDefaultViewSet" Text="Ustaw bieżący" Click="OnSaveDefaultView">
              <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80F;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="MapDefaultViewGo" Text="Przejdź" Click="OnGoDefaultView">
              <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE707;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="MapDefaultViewDelete" Text="Usuń" Click="OnDeleteDefaultView">
              <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
          </MenuFlyoutSubItem>
        </MenuFlyout>
      </Grid.ContextFlyout>

      <mapsui:MapControl x:Name="Map" />

      <!-- Przyciski powiększenia (dostępność, ekrany bez kółka myszy) -->
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Spacing="2">
        <Button x:Uid="MapZoomIn" Width="34" Height="34" Padding="0" Click="OnZoomIn" AutomationProperties.Name="Przybliż"
                Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="1" CornerRadius="4">
          <FontIcon Glyph="&#xE710;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
        </Button>
        <Button x:Uid="MapZoomOut" Width="34" Height="34" Padding="0" Click="OnZoomOut" AutomationProperties.Name="Oddal"
                Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="1" CornerRadius="4">
          <FontIcon Glyph="&#xE738;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
        </Button>
      </StackPanel>

      <!-- Okno informacji o obiekcie / punkcie -->
      <Canvas x:Name="PopupCanvas">
        <Border x:Name="Popup" Visibility="Collapsed" MaxWidth="300" Padding="12,10"
                Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="1" CornerRadius="8">
          <Grid>
            <StackPanel x:Name="PopupContent" Spacing="2" Margin="0,0,20,0" />
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                    Margin="0,-4,-6,0" Click="OnPopupClose" Style="{StaticResource TextButtonStyle}" x:Uid="PopupClose" AutomationProperties.Name="Zamknij">
              <FontIcon Glyph="&#xE711;" FontSize="10" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
            </Button>
          </Grid>
        </Border>
      </Canvas>

      <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4" FontSize="11"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" x:Uid="MapAttribution" Text="© OpenStreetMap contributors" />
    </Grid>
  </controls:PanelFrame>
</UserControl>
