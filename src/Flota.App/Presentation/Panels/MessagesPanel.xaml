<UserControl x:Class="Flota.App.Presentation.Panels.MessagesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Flota.App.Controls">
  <!-- Aplikacja źródłowa nie pobiera wiadomości; komunikacja tekstowa i głosowa — faza 6 planu (K2) -->
  <controls:PanelFrame x:Uid="PanelMessages" Title="Wiadomości" Icon="messages_16x16.png">
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,12">
      <Image Source="ms-appx:///Assets/Images/messages_32x32.png" Width="24" Height="24" Opacity="0.6" />
      <TextBlock x:Uid="MessagesUnavailable" Text="Wiadomości do urządzeń będą dostępne po udostępnieniu tej funkcji w UniAVL API."
                 Style="{StaticResource FlotaCaptionTextStyle}" TextWrapping="Wrap" MaxWidth="360" />
    </StackPanel>
  </controls:PanelFrame>
</UserControl>
