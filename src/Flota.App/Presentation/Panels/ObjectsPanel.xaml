<UserControl x:Class="Flota.App.Presentation.Panels.ObjectsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Flota.App.Controls"
             xmlns:fleet="using:Flota.Presentation.Fleet"
             xmlns:services="using:Flota.App.Services">

  <controls:PanelFrame x:Uid="PanelObjects" Title="Obiekty" Icon="tracking_objects_16x16.png">
    <controls:PanelFrame.Toolbar>
      <Grid ColumnSpacing="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:ToolButton x:Name="RefreshButton" x:Uid="ObjectsRefresh" Label="Odśwież" Icon="refresh_16x16.png" Click="OnRefreshClick" />
        <controls:ToolButton x:Name="TraceButton" Grid.Column="1" x:Uid="ObjectsTrace" Label="Śledź" Icon="trace_16x16.png" Click="OnTraceClick" />
        <TextBox x:Name="FilterBox" Grid.Column="2" x:Uid="ObjectsFilter" PlaceholderText="Szukaj obiektu"
                 MinWidth="80" Style="{StaticResource DefaultTextBoxStyle}" FontSize="13" VerticalAlignment="Center" Margin="4,0,2,0" TextChanged="OnFilterChanged" />
      </Grid>
    </controls:PanelFrame.Toolbar>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Nagłówki kolumn: ✓, Nazwa, status, Lokalizacja -->
      <Grid Background="{ThemeResource FlotaToolbarBrush}" MinHeight="32" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="44" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <CheckBox x:Name="AllVisibleBox" MinWidth="0" Padding="0" HorizontalAlignment="Center" IsThreeState="False"
                  x:Uid="ObjectsAllVisible" AutomationProperties.Name="Pokaż wszystkie na mapie" Click="OnAllVisibleClick" />
        <Button Grid.Column="1" Tag="Name" Click="OnSortClick" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,0">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock x:Uid="ObjectsColName" Text="Nazwa" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" />
            <FontIcon x:Name="SortName" FontSize="9" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Tag="Status" Click="OnSortClick" Style="{StaticResource TextButtonStyle}" Padding="0" HorizontalAlignment="Stretch"
                x:Uid="ObjectsColStatus" AutomationProperties.Name="Status">
          <FontIcon x:Name="SortStatus" FontSize="9" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
        </Button>
        <Button Grid.Column="3" Tag="Location" Click="OnSortClick" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,0">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock x:Uid="ObjectsColLocation" Text="Lokalizacja" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" />
            <FontIcon x:Name="SortLocation" FontSize="9" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
          </StackPanel>
        </Button>
      </Grid>

      <ListView x:Name="List"
                Grid.Row="1"
                SelectionMode="Single"
                IsItemClickEnabled="False"
                SelectionChanged="OnSelectionChanged"
                DoubleTapped="OnDoubleTapped">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="fleet:ObjectItem">
            <Grid MinHeight="34" ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <CheckBox MinWidth="0" Padding="0" HorizontalAlignment="Center"
                        IsChecked="{x:Bind IsVisibleOnMap, Mode=TwoWay}"
                        IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                        Click="OnVisibleClick"
                        AutomationProperties.Name="{x:Bind Name}" />
              <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="4,0" />
              <!-- Przycisk statusu: okrąg w kolorze statusu z ikoną typu obiektu -->
              <Button Grid.Column="2" Width="30" Height="30" Padding="0" CornerRadius="15" MinWidth="0" MinHeight="0"
                      Background="{x:Bind services:StatusBrushes.For(Status), Mode=OneWay}" BorderThickness="0" HorizontalAlignment="Center"
                      Click="OnStatusClick" ToolTipService.ToolTip="{x:Bind StatusName, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind StatusName, Mode=OneWay}">
                <Image Source="{x:Bind IconUri}" Width="20" Height="20" />
              </Button>
              <TextBlock Grid.Column="3" Text="{x:Bind LocationText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="4,0" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <TextBlock x:Name="CountText" Grid.Row="2" Style="{StaticResource FlotaCaptionTextStyle}" Margin="6,4" />
    </Grid>
  </controls:PanelFrame>
</UserControl>
