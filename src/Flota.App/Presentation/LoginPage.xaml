<Page x:Class="Flota.App.Presentation.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:Flota.App.Controls"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Padding="16" MinHeight="480">
        <Border MaxWidth="420"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Padding="28,24"
                Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="12">
          <StackPanel Spacing="16">
            <Image Source="ms-appx:///Assets/Images/logo.png"
                   Width="224" Height="84"
                   HorizontalAlignment="Center"
                   AutomationProperties.Name="UNI-AVL" />
            <TextBlock x:Uid="LoginTitle"
                       Text="Logowanie"
                       HorizontalAlignment="Center"
                       Style="{StaticResource TitleLarge}"
                       Foreground="{ThemeResource FlotaAccentBrush}" />

            <TextBox x:Name="UserBox"
                     x:Uid="LoginUser"
                     Header="Użytkownik"
                     IsSpellCheckEnabled="False"
                     InputScope="EmailNameOrAddress"
                     KeyDown="OnFieldKeyDown" />
            <TextBlock x:Name="UserError" x:Uid="LoginUserRequired" Text="Wprowadź prawidłowy login"
                       Foreground="{ThemeResource ErrorBrush}" FontSize="12" Visibility="Collapsed" Margin="0,-10,0,0" />

            <PasswordBox x:Name="PasswordBox"
                         x:Uid="LoginPassword"
                         Header="Hasło"
                         KeyDown="OnFieldKeyDown" />
            <TextBlock x:Name="PasswordError" x:Uid="LoginPasswordRequired" Text="Wprowadź hasło"
                       Foreground="{ThemeResource ErrorBrush}" FontSize="12" Visibility="Collapsed" Margin="0,-10,0,0" />

            <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Error" IsOpen="False" />

            <Button x:Name="LoginButton"
                    x:Uid="LoginButton"
                    Content="Zaloguj"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource FilledButtonStyle}"
                    Click="OnLoginClick" />
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <!-- Wersja przeglądarkowa: pakiet Android do pobrania (T9.5) -->
            <controls:AndroidDownloadLink />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
