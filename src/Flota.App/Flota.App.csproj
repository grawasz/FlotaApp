<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.26100;net10.0-browserwasm</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>Flota.App</RootNamespace>
    <DefaultLanguage>pl-PL</DefaultLanguage>

    <ApplicationTitle>Flota</ApplicationTitle>
    <!-- Identyfikator pakietu: wartość domyślna szablonu do czasu rozstrzygnięcia K9 -->
    <ApplicationId>com.companyname.flota-app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Flota</ApplicationPublisher>
    <Description>Flota — monitorowanie floty pojazdów</Description>

    <UnoFeatures>
      Material;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      Http;
      Serialization;
      Localization;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <!-- Wyłącznie wersja przeglądarkowa (obraz Docker na Linux — bez obciążeń Android/iOS i pakietów Windows): -p:FlotaWebOnly=true -->
  <PropertyGroup Condition="'$(FlotaWebOnly)' == 'true'">
    <TargetFrameworks>net10.0-browserwasm</TargetFrameworks>
  </PropertyGroup>

  <!-- SDK 10.0.4xx dopisuje RID hosta (win-x64) przy PublishTrimmed; dla Android/Mono brak pakietu Runtime.Mono.win-x64 -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
  </PropertyGroup>

  <!-- WebAssembly: generator JSImport wymaga kodu unsafe -->
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-browserwasm'))">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    WebAssembly: profilowana kompilacja AOT (T9.3a) — domyślnie w buildzie Release; wyłączenie: -p:FlotaWasmAot=false.
    Profil Platforms/WebAssembly/aot.profile dołączany przez Uno.Sdk (konwencja, inny plik: -p:WasmAotProfilePath=<ścieżka>);
    zbierany buildem z -p:WasmShellGenerateAOTProfile=true i skryptem tools/TestyUi/profil-aot.mjs (docs/WEB.md);
    build zbierający profil działa bez AOT.
  -->
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-browserwasm')) and '$(Configuration)' == 'Release' and '$(FlotaWasmAot)' == '' and '$(WasmShellGenerateAOTProfile)' != 'true'">
    <FlotaWasmAot>true</FlotaWasmAot>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-browserwasm')) and '$(FlotaWasmAot)' == 'true'">
    <WasmShellMonoRuntimeExecutionMode>InterpreterAndAOT</WasmShellMonoRuntimeExecutionMode>
  </PropertyGroup>

  <!-- Ikona AVL (z avl.ico aplikacji źródłowej): na Windows tło z zaokrąglonymi narożnikami; Android i iOS maskują kształt samodzielnie -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <UnoIconBackgroundFile>Assets\Icons\icon_windows.svg</UnoIconBackgroundFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mapsui.Uno.WinUI" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Uno.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flota.Core\Flota.Core.csproj" />
    <ProjectReference Include="..\Flota.Client\Flota.Client.csproj" />
    <ProjectReference Include="..\Flota.Presentation\Flota.Presentation.csproj" />
  </ItemGroup>
</Project>
