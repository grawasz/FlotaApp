<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <!--
    Paleta Material 3 aplikacji Flota (plan, rozdz. 7.1): kolory motywu Radzen Material 3 i logo.
    Motyw ciemny: warianty tonalne tych samych kolorów bazowych.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#3481E5</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#BCD8FF</Color>
      <Color x:Key="OnPrimaryContainerColor">#00215D</Color>
      <Color x:Key="SecondaryColor">#5B6471</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#DDE3EA</Color>
      <Color x:Key="OnSecondaryContainerColor">#1A2029</Color>
      <Color x:Key="TertiaryColor">#EA5A12</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#FFDBCC</Color>
      <Color x:Key="OnTertiaryContainerColor">#351000</Color>
      <Color x:Key="ErrorColor">#B3261E</Color>
      <Color x:Key="ErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="OnErrorContainerColor">#410E0B</Color>
      <Color x:Key="BackgroundColor">#EBEFF1</Color>
      <Color x:Key="OnBackgroundColor">#1B1B1F</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#1B1B1F</Color>
      <Color x:Key="SurfaceVariantColor">#F0F0F0</Color>
      <Color x:Key="OnSurfaceVariantColor">#44474E</Color>
      <Color x:Key="OutlineColor">#74777F</Color>
      <Color x:Key="OutlineVariantColor">#C4C6D0</Color>
      <Color x:Key="OnSurfaceInverseColor">#F2F0F4</Color>
      <Color x:Key="SurfaceInverseColor">#303034</Color>
      <Color x:Key="PrimaryInverseColor">#A9C7FF</Color>
      <Color x:Key="SurfaceTintColor">#3481E5</Color>

      <!-- Zasoby własne -->
      <Color x:Key="FlotaAccentColor">#1A126C</Color>
      <Color x:Key="FlotaToolbarColor">#EBEFF1</Color>
      <Color x:Key="FlotaSeparatorColor">#A9A9A9</Color>
      <Color x:Key="FlotaRouteLineColor">#0000FF</Color>
      <Color x:Key="FlotaSelectionOutlineColor">#2F4F4F</Color>
      <Color x:Key="FlotaTooltipSelectedColor">#8B0000</Color>
      <Color x:Key="FlotaPopupNameColor">#4682B4</Color>
      <Color x:Key="FlotaPopupRegistrationColor">#FF6347</Color>
      <Color x:Key="FlotaSensorOnColor">#008000</Color>
      <Color x:Key="FlotaSensorOffColor">#D3D3D3</Color>
      <Color x:Key="StatusMovingColor">#008000</Color>
      <Color x:Key="StatusStoppedColor">#FFA500</Color>
      <Color x:Key="StatusNoGpsColor">#808080</Color>
      <Color x:Key="StatusOutdatedColor">#FF0000</Color>
      <Color x:Key="StatusUnknownColor">#FFFFFF</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#A9C7FF</Color>
      <Color x:Key="OnPrimaryColor">#003063</Color>
      <Color x:Key="PrimaryContainerColor">#00468C</Color>
      <Color x:Key="OnPrimaryContainerColor">#D6E3FF</Color>
      <Color x:Key="SecondaryColor">#BDC7D4</Color>
      <Color x:Key="OnSecondaryColor">#27313C</Color>
      <Color x:Key="SecondaryContainerColor">#3E4853</Color>
      <Color x:Key="OnSecondaryContainerColor">#D9E3F0</Color>
      <Color x:Key="TertiaryColor">#FFB597</Color>
      <Color x:Key="OnTertiaryColor">#581E00</Color>
      <Color x:Key="TertiaryContainerColor">#7C2E00</Color>
      <Color x:Key="OnTertiaryContainerColor">#FFDBCC</Color>
      <Color x:Key="ErrorColor">#FFB4AB</Color>
      <Color x:Key="ErrorContainerColor">#93000A</Color>
      <Color x:Key="OnErrorColor">#690005</Color>
      <Color x:Key="OnErrorContainerColor">#FFDAD6</Color>
      <Color x:Key="BackgroundColor">#121316</Color>
      <Color x:Key="OnBackgroundColor">#E3E2E6</Color>
      <Color x:Key="SurfaceColor">#1B1B1F</Color>
      <Color x:Key="OnSurfaceColor">#E3E2E6</Color>
      <Color x:Key="SurfaceVariantColor">#2A2D33</Color>
      <Color x:Key="OnSurfaceVariantColor">#C4C6D0</Color>
      <Color x:Key="OutlineColor">#8E9099</Color>
      <Color x:Key="OutlineVariantColor">#44474E</Color>
      <Color x:Key="OnSurfaceInverseColor">#303034</Color>
      <Color x:Key="SurfaceInverseColor">#E3E2E6</Color>
      <Color x:Key="PrimaryInverseColor">#3481E5</Color>
      <Color x:Key="SurfaceTintColor">#A9C7FF</Color>

      <Color x:Key="FlotaAccentColor">#C3C0FF</Color>
      <Color x:Key="FlotaToolbarColor">#23262B</Color>
      <Color x:Key="FlotaSeparatorColor">#5F6368</Color>
      <Color x:Key="FlotaRouteLineColor">#4D7CFF</Color>
      <Color x:Key="FlotaSelectionOutlineColor">#E3E2E6</Color>
      <Color x:Key="FlotaTooltipSelectedColor">#FF8A80</Color>
      <Color x:Key="FlotaPopupNameColor">#8FB8DE</Color>
      <Color x:Key="FlotaPopupRegistrationColor">#FF8C73</Color>
      <Color x:Key="FlotaSensorOnColor">#2E9E3E</Color>
      <Color x:Key="FlotaSensorOffColor">#5F6368</Color>
      <Color x:Key="StatusMovingColor">#008000</Color>
      <Color x:Key="StatusStoppedColor">#FFA500</Color>
      <Color x:Key="StatusNoGpsColor">#808080</Color>
      <Color x:Key="StatusOutdatedColor">#FF0000</Color>
      <Color x:Key="StatusUnknownColor">#FFFFFF</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
