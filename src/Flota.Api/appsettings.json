{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "UniAvl": {
    "BaseUrl": "http://geo.uniavl.pl/AVL/",
    "Timeout": "00:01:00"
  },
  "Targeo": {
    "BatchSize": 50,
    "MaxConcurrency": 2
  },
  "Auth": {
    "AccessTokenLifetime": "00:30:00",
    "SessionLifetime": "30.00:00:00"
  },
  "Reports": {
    "MaxConcurrency": 6,
    "ChartPoints": 1000
  },
  "Live": {
    "PollInterval": "00:00:10"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Flota": "Data Source=App_Data/flota.db"
  }
}
