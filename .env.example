# Wzór pliku .env dla docker compose. Skopiować do .env i uzupełnić; .env nie jest zatwierdzany w repozytorium.

# Hasło bazy PostgreSQL (wymagane)
POSTGRES_PASSWORD=

# Port Flota.Api na hoście (domyślnie 5294)
FLOTA_API_PORT=

# Klucz podpisu JWT, Base64, min. 32 bajty (np. wynik: openssl rand -base64 32)
AUTH_SIGNING_KEY=

# Targeo — geokodowanie odwrotne; brak wartości wyłącza pobieranie adresów
TARGEO_ENDPOINT=
TARGEO_USER=
TARGEO_PASSWORD=
TARGEO_SALT=
