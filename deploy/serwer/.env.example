# Wzór pliku .env serwera (docs/WDROZENIE.md). Skopiować do .env obok docker-compose.yml i uzupełnić;
# plik .env zawiera sekrety — wyłącznie na serwerze, uprawnienia 600, poza repozytorium.

# Domena serwera (certyfikat Let's Encrypt, AllowedHosts Flota.Api)
FLOTA_DOMAIN=flota.ovh
# Adres e-mail konta ACME (powiadomienia Let's Encrypt); pusty — certyfikat bez adresu kontaktowego
ACME_EMAIL=

# Obraz dotychczasowej aplikacji Blazor (nazwa:tag jak w bieżącym uruchomieniu kontenera flota)
FLOTA_BLAZOR_IMAGE=
# Obraz Flota.Api wczytany przez docker load (nazwa:tag z deploy/serwer/zapisz-obraz.ps1)
FLOTA_API_IMAGE=

# Hasło bazy PostgreSQL (np. wynik: openssl rand -base64 24)
POSTGRES_PASSWORD=
# Klucz podpisu JWT, Base64, min. 32 bajty (np. wynik: openssl rand -base64 32)
AUTH_SIGNING_KEY=

# Targeo — geokodowanie odwrotne; brak wartości wyłącza pobieranie adresów
TARGEO_ENDPOINT=
TARGEO_USER=
TARGEO_PASSWORD=
TARGEO_SALT=

# Katalog pakietu Android (*.apk) na serwerze, udostępniany pod /pobierz/ (domyślnie ./pobierz)
FLOTA_DOWNLOADS_DIR=
# Wersja pakietu wyświetlana przy odnośniku; pusta — odczyt z manifestu pakietu
ANDROID_VERSION=

# Sieć kontenerów i stały adres Caddy (zmiana wyłącznie przy konflikcie z inną siecią na serwerze)
FLOTA_NETWORK_SUBNET=
FLOTA_CADDY_IP=

# Wyłącznie weryfikacja lokalna (docker-compose.test.yml): certyfikaty z wewnętrznego urzędu Caddy zamiast Let's Encrypt
CADDY_LOCAL_CERTS=
